{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Athena Sandbox Protocol",
  "version": 1,
  "maxLineBytes": 1048576,
  "errorCodes": {
    "PARSE_ERROR": -32700,
    "INVALID_REQUEST": -32600,
    "METHOD_NOT_FOUND": -32601,
    "INVALID_PARAMS": -32602,
    "INTERNAL": -32603,
    "PROTOCOL_UNSUPPORTED": -32001,
    "NOT_FOUND": -32002,
    "CONFLICT": -32003,
    "EVENTS_EXPIRED": -32004,
    "UNAVAILABLE": -32005,
    "INVALID_STATE": -32007
  },
  "methods": {
    "hello": {
      "params": {
        "$ref": "#/$defs/hello.params"
      },
      "result": {
        "$ref": "#/$defs/hello.result"
      }
    },
    "ping": {
      "params": {
        "$ref": "#/$defs/ping.params"
      },
      "result": {
        "$ref": "#/$defs/ping.result"
      }
    },
    "events.subscribe": {
      "params": {
        "$ref": "#/$defs/events.subscribe.params"
      },
      "result": {
        "$ref": "#/$defs/events.subscribe.result"
      }
    },
    "workspace.info": {
      "params": {
        "$ref": "#/$defs/workspace.info.params"
      },
      "result": {
        "$ref": "#/$defs/workspace.info.result"
      }
    },
    "workspace.diff": {
      "params": {
        "$ref": "#/$defs/workspace.diff.params"
      },
      "result": {
        "$ref": "#/$defs/workspace.diff.result"
      }
    },
    "models.list": {
      "params": {
        "$ref": "#/$defs/models.list.params"
      },
      "result": {
        "$ref": "#/$defs/models.list.result"
      }
    },
    "task.start": {
      "params": {
        "$ref": "#/$defs/task.start.params"
      },
      "result": {
        "$ref": "#/$defs/task.start.result"
      }
    },
    "task.get": {
      "params": {
        "$ref": "#/$defs/task.get.params"
      },
      "result": {
        "$ref": "#/$defs/task.get.result"
      }
    },
    "task.stop": {
      "params": {
        "$ref": "#/$defs/task.stop.params"
      },
      "result": {
        "$ref": "#/$defs/task.stop.result"
      }
    },
    "request.resolve": {
      "params": {
        "$ref": "#/$defs/request.resolve.params"
      },
      "result": {
        "$ref": "#/$defs/request.resolve.result"
      }
    },
    "service.list": {
      "params": {
        "$ref": "#/$defs/service.list.params"
      },
      "result": {
        "$ref": "#/$defs/service.list.result"
      }
    },
    "service.start": {
      "params": {
        "$ref": "#/$defs/service.start.params"
      },
      "result": {
        "$ref": "#/$defs/service.start.result"
      }
    },
    "service.stop": {
      "params": {
        "$ref": "#/$defs/service.stop.params"
      },
      "result": {
        "$ref": "#/$defs/service.stop.result"
      }
    },
    "service.restart": {
      "params": {
        "$ref": "#/$defs/service.restart.params"
      },
      "result": {
        "$ref": "#/$defs/service.restart.result"
      }
    },
    "service.logs": {
      "params": {
        "$ref": "#/$defs/service.logs.params"
      },
      "result": {
        "$ref": "#/$defs/service.logs.result"
      }
    },
    "command.run": {
      "params": {
        "$ref": "#/$defs/command.run.params"
      },
      "result": {
        "$ref": "#/$defs/command.run.result"
      }
    },
    "command.get": {
      "params": {
        "$ref": "#/$defs/command.get.params"
      },
      "result": {
        "$ref": "#/$defs/command.get.result"
      }
    },
    "command.stop": {
      "params": {
        "$ref": "#/$defs/command.stop.params"
      },
      "result": {
        "$ref": "#/$defs/command.stop.result"
      }
    }
  },
  "$defs": {
    "ModelSelection": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "maxLength": 200
        },
        "effort": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "model"
      ]
    },
    "ExecutionModel": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "string",
          "maxLength": 200
        },
        "model": {
          "type": "string",
          "maxLength": 200
        },
        "effort": {
          "type": "string",
          "maxLength": 50
        }
      }
    },
    "ModelOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 200
        },
        "model": {
          "type": "string",
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "isDefault": {
          "type": "boolean"
        },
        "efforts": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 50
              },
              "description": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "id",
              "description"
            ]
          }
        },
        "defaultEffort": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": [
        "id",
        "model",
        "name",
        "description",
        "isDefault",
        "efforts"
      ]
    },
    "TokenCounts": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cachedInputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheWriteInputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoningOutputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "totalTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "cachedInputTokens",
        "cacheWriteInputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ]
    },
    "ApprovalRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "detail": {
          "type": "string",
          "maxLength": 20000
        },
        "kind": {
          "type": "string",
          "enum": [
            "command",
            "file",
            "other"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "detail",
        "kind"
      ]
    },
    "UserInputRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "questions": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "header": {
                "type": "string",
                "maxLength": 200
              },
              "question": {
                "type": "string",
                "maxLength": 4000
              },
              "isSecret": {
                "type": "boolean"
              },
              "isOther": {
                "type": "boolean"
              },
              "options": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "label",
                    "description"
                  ]
                }
              }
            },
            "required": [
              "id",
              "header",
              "question",
              "isSecret"
            ]
          }
        }
      },
      "required": [
        "id",
        "questions"
      ]
    },
    "PendingRequest": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "approval"
            },
            "request": {
              "$ref": "#/$defs/ApprovalRequest"
            }
          },
          "required": [
            "kind",
            "request"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "input"
            },
            "request": {
              "$ref": "#/$defs/UserInputRequest"
            }
          },
          "required": [
            "kind",
            "request"
          ]
        }
      ]
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "input": {},
        "status": {
          "type": "string",
          "enum": [
            "running",
            "done",
            "error"
          ]
        },
        "output": {
          "type": "string",
          "maxLength": 20000
        },
        "startedAt": {
          "description": "Unix epoch milliseconds",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finishedAt": {
          "description": "Unix epoch milliseconds",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "name",
        "status"
      ]
    },
    "PlanStep": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "inProgress",
            "completed"
          ]
        }
      },
      "required": [
        "step",
        "status"
      ]
    },
    "Repo": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2000
        },
        "ref": {
          "type": "string",
          "maxLength": 200
        },
        "commit": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "url"
      ]
    },
    "WorkspaceInfo": {
      "type": "object",
      "properties": {
        "repos": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2000
              },
              "ref": {
                "type": "string",
                "maxLength": 200
              },
              "commit": {
                "type": "string",
                "maxLength": 64
              },
              "path": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "url",
              "path"
            ]
          }
        },
        "agent": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 50
            },
            "status": {
              "type": "string",
              "enum": [
                "ready",
                "unavailable"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "id",
            "status"
          ]
        },
        "activeTaskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "required": [
        "repos",
        "agent"
      ]
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "waiting",
            "stopping",
            "completed",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "pendingRequests": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "#/$defs/PendingRequest"
          }
        },
        "failure": {
          "type": "string",
          "maxLength": 4000
        },
        "createdAt": {
          "description": "Unix epoch milliseconds",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updatedAt": {
          "description": "Unix epoch milliseconds",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "status",
        "pendingRequests",
        "createdAt",
        "updatedAt"
      ]
    },
    "HealthCheck": {
      "type": "object",
      "properties": {
        "path": {
          "description": "HTTP path; TCP connect check when omitted",
          "type": "string",
          "maxLength": 500
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "Service": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 63
        },
        "status": {
          "type": "string",
          "enum": [
            "starting",
            "healthy",
            "unhealthy",
            "stopped",
            "failed"
          ]
        },
        "port": {
          "description": "Listening port inside the workspace; Athena derives the Coder URL from it",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "message": {
          "type": "string",
          "maxLength": 4000
        },
        "updatedAt": {
          "description": "Unix epoch milliseconds",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "port",
        "updatedAt"
      ]
    },
    "Command": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "command": {
          "type": "string",
          "maxLength": 4000
        },
        "cwd": {
          "type": "string",
          "maxLength": 4000
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "exitCode": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "signal": {
          "type": "string",
          "maxLength": 20
        },
        "outputBytes": {
          "description": "Total output produced so far",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "startedAt": {
          "description": "Unix epoch milliseconds",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finishedAt": {
          "description": "Unix epoch milliseconds",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "command",
        "cwd",
        "status",
        "outputBytes",
        "startedAt"
      ]
    },
    "TaskEvent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "started"
            },
            "model": {
              "$ref": "#/$defs/ExecutionModel"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "status"
            },
            "status": {
              "type": "string",
              "enum": [
                "thinking",
                "working",
                "waiting",
                "idle"
              ]
            },
            "label": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "type",
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "delta"
            },
            "text": {
              "type": "string",
              "maxLength": 64000
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tool"
            },
            "call": {
              "$ref": "#/$defs/ToolCall"
            }
          },
          "required": [
            "type",
            "call"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plan"
            },
            "steps": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/PlanStep"
              }
            }
          },
          "required": [
            "type",
            "steps"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "approval"
            },
            "request": {
              "$ref": "#/$defs/ApprovalRequest"
            }
          },
          "required": [
            "type",
            "request"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "user-input"
            },
            "request": {
              "$ref": "#/$defs/UserInputRequest"
            }
          },
          "required": [
            "type",
            "request"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "request-resolved"
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          },
          "required": [
            "type",
            "requestId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "usage"
            },
            "total": {
              "$ref": "#/$defs/TokenCounts"
            },
            "last": {
              "$ref": "#/$defs/TokenCounts"
            }
          },
          "required": [
            "type",
            "total",
            "last"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "completed"
            },
            "text": {
              "type": "string",
              "maxLength": 64000
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "failed"
            },
            "message": {
              "type": "string",
              "maxLength": 4000
            },
            "code": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": [
            "type",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "ServerEvent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "workspace.state"
            },
            "workspace": {
              "$ref": "#/$defs/WorkspaceInfo"
            }
          },
          "required": [
            "type",
            "workspace"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "task.state"
            },
            "task": {
              "$ref": "#/$defs/Task"
            }
          },
          "required": [
            "type",
            "task"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "task.event"
            },
            "taskId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "event": {
              "$ref": "#/$defs/TaskEvent"
            }
          },
          "required": [
            "type",
            "taskId",
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "service.state"
            },
            "service": {
              "$ref": "#/$defs/Service"
            }
          },
          "required": [
            "type",
            "service"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "service.removed"
            },
            "serviceId": {
