{
  "name": "athena",
  "version": "0.9.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Dylan",
  "description": "A local AI workspace with an interactive BrowserOS neo surface and Feishu connectivity.",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-main.mjs",
    "size:app": "node scripts/measure-app-size.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx tests/electron.e2e.ts",
    "test:live-agent": "tsx tests/live-agent.e2e.ts",
    "test:live-pi": "tsx tests/pi-live.e2e.ts",
    "test:live-cli": "tsx tests/stream-cli-live.e2e.ts",
    "setup:browseros": "node scripts/setup-browseros.mjs",
    "package": "npm run build && electron-builder --mac dir",
    "heroui:setup": "node scripts/setup-heroui-pro.mjs",
    "postinstall": "npm run heroui:setup",
    "test:sharing": "tsx tests/sharing.e2e.ts",
    "test:complex-agent": "tsx tests/complex-agent.e2e.ts",
    "test:models": "tsx tests/model-usage.e2e.ts",
    "test:agent-experience": "tsx tests/agent-experience.e2e.ts",
    "package:signed": "npm run build && electron-builder --config scripts/electron-builder.signed.cjs --mac dir --arm64 --publish never",
    "package:release": "npm run build && electron-builder --config scripts/electron-builder.release.cjs --mac dmg zip --arm64 --publish never",
    "release:upload": "node scripts/upload-release.mjs",
    "version:bump": "bumpp package.json package-lock.json --no-commit --no-tag --no-push --ignore-scripts"
  },
  "build": {
    "appId": "app.agent.workbench",
    "productName": "Athena",
    "electronDist": "node_modules/electron/dist",
    "compression": "maximum",
    "directories": {
      "output": "release/v${version}"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "!dist/**/*.map",
      "!node_modules/**/*",
      "node_modules/**/{LICENSE,License,license,LICENCE,Licence,licence,NOTICE,Notice,notice,COPYING,Copying,copying}{,.*,-*}"
    ],
    "mac": {
      "icon": "resources/athena-icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Athena 需要连接你选择的局域网，与受邀者共享当前网页。"
      }
    },
    "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
  },
  "dependencies": {
    "@a2ui/react": "0.14.0",
    "@a2ui/web_core": "0.14.0",
    "@heroui-pro/react": "1.0.0-beta.10",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@hugeicons-pro/core-stroke-rounded": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@tiptap/core": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "json5": "^2.2.3",
    "motion": "14.9.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.15.3",
    "remark-gfm": "4.0.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "3.5.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "bumpp": "^11.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "hpsetup": "4.7.4",
    "minimatch": "^10.2.6",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "tar": "7.5.22",
    "figlet": "1.12.0"
  }
}
